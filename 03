package collection;

import java.util.LinkedList;

public class Exp03 {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		LinkedList ll=new LinkedList();
		
ll.add(10);
ll.add(20.5);
ll.add("java");
ll.add(40);
ll.addFirst(40);
ll.addFirst(50);
ll.addFirst(50);
ll.addLast(99);
System.out.println(ll);

System.out.println(ll.getFirst());//same//
System.out.println(ll.getLast());
System.out.println(ll.peekFirst());//same//
System.out.println(ll);
System.out.println(ll.pollFirst());//same//
System.out.println(ll);
System.out.println(ll.peekLast());
System.out.println(ll);

System.out.println(ll.pollLast());
System.out.println(ll);



	}

}

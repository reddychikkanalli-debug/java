public class Main {
    public static void main(String[] args) {

        String s = "programming";

        for (int i = 0; i < s.length(); i++) {
            int count = 0;

            if (s.charAt(i) == ' ') {
                continue;
            }

            boolean found = false;

            for (int j = 0; j < i; j++) {
                if (s.charAt(i) == s.charAt(j)) {
                    found = true;
                    break;
                }
            }

            if (!found) {
                for (int j = 0; j < s.length(); j++) {
                    if (s.charAt(i) == s.charAt(j)) {
                        count++;
                    }
                }

                System.out.println(s.charAt(i) + " = " + count);
            }
        }
    }
}

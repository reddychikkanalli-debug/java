
import java.util.*;

public class Main {
    public static void main(String[] args) {

        int[] a = {1, 2, 3, 2, 4, 1, 5};

        ArrayList<Integer> list = new ArrayList<>();

        for (int i = 0; i < a.length; i++) {
            if (!list.contains(a[i])) {
                list.add(a[i]);
            }
        }

        System.out.println("After removing duplicates: " + list);
    }
}
